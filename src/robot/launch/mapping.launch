<launch>
  <!-- Arguments -->
  <arg name="use_sim_time" default="true" />
  <arg name="scan_topic" default="/device/lidar/scan" />
  <arg name="map_file" default="$(find robot)/maps/generated_map" />

  <!-- SLAM Toolbox Mapping Node -->
  <node pkg="slam_toolbox" type="async_slam_toolbox_node" name="slam_toolbox" output="screen">
    <rosparam command="load" file="$(find robot)/config/mapper_params.yaml" />
    <param name="use_sim_time" value="$(arg use_sim_time)" />
    <remap from="scan" to="$(arg scan_topic)" />
  </node>

  <!-- RViz -->
  <node pkg="rviz" type="rviz" name="rviz" 
        args="-d $(find robot)/rviz/slam_toolbox.rviz" />
</launch>