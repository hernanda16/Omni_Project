<launch>
  <node pkg="map_server" type="map_server" name="map_server" 
        args="$(find robot)/maps/20250403_200900.yaml"/>
  
  <!-- SLAM Toolbox in localization mode -->
  <node pkg="slam_toolbox" type="localization_slam_toolbox_node" name="slam_toolbox">
    <rosparam command="load" file="$(find robot)/config/mapper_params.yaml"/>
    <param name="map_file" value="$(find robot)/maps/20250403_200900.yaml"/>
    <remap from="scan" to="/device/lidar/scan"/>
  </node>
  
  <!-- RViz -->
  <node pkg="rviz" type="rviz" name="rviz" 
        args="-d $(find robot)/rviz/omni_lss.rviz"/>
</launch>